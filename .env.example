# Database (PostgreSQL lokal via Laragon)
# Sesuaikan password dan port dengan konfigurasi PostgreSQL di Laragon kamu
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/eventspace?schema=public"

# Auth.js
# Generate secret baru dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-secret-acak"
AUTH_URL="http://localhost:3000"

# Storage (isi di tahap upload gambar nanti)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
